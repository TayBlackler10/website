<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>M2 Training Club</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600&family=Bebas+Neue&display=swap" rel="stylesheet">
<style>
/* ── RESET ────────────────────────────────────────── */
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#F5F5F0;
  --bg2:#EBEBEB;
  --bg3:#E0E0D8;
  --white:#FFFFFF;
  --black:#0D0D0D;
  --black2:#1A1A1A;
  --text:#0D0D0D;
  --text2:#4A4A4A;
  --text3:#888888;
  --text4:#BBBBBB;
  --lime:#C8FF00;
  --lime-dark:#A8D800;
  --lime-dim:rgba(200,255,0,0.12);
  --lime-mid:rgba(200,255,0,0.3);
  --green:#15803D;
  --green-bg:#DCFCE7;
  --red:#DC2626;
  --blue:#2563EB;
  --orange:#EA580C;
  --border:#DCDCD4;
  --border2:#E8E8E0;
  --shadow:0 2px 12px rgba(0,0,0,0.08);
  --shadow-lg:0 8px 32px rgba(0,0,0,0.12);
  --nav-h:64px;
  --safe-t:env(safe-area-inset-top,44px);
  --safe-b:env(safe-area-inset-bottom,20px);
  --r:16px;
  --r2:12px;
  --r3:8px;
  --font:'Montserrat',sans-serif;
  --font2:'Inter',sans-serif;
}
html,body{background:var(--bg)!important}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--font);overflow:hidden}
body{display:flex;flex-direction:column}
#app{flex:1;display:flex;flex-direction:column;overflow:hidden}
.screen{flex:1;overflow-y:auto;overflow-x:hidden;display:none;-webkit-overflow-scrolling:touch;
  padding-bottom:calc(var(--nav-h) + var(--safe-b) + 8px);scrollbar-width:none;background:var(--bg)}
.screen::-webkit-scrollbar{display:none}
.screen.active{display:block}

/* ── NAV ──────────────────────────────────────────── */
.nav{
  height:calc(var(--nav-h) + var(--safe-b));
  background:var(--white);
  border-top:1px solid var(--border);
  display:flex;align-items:flex-start;padding-top:10px;
  position:relative;z-index:50;flex-shrink:0;
  box-shadow:0 -2px 12px rgba(0,0,0,0.06);
}
.ni{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;padding:2px 0;transition:opacity 0.15s}
.ni svg{width:22px;height:22px;stroke:var(--text4);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:stroke 0.2s}
.ni span{font-size:10px;color:var(--text4);font-weight:600;transition:color 0.2s;letter-spacing:0.3px;font-family:var(--font)}
.ni.active svg{stroke:var(--black)}
.ni.active span{color:var(--black)}
.ni-center{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;padding:0}
.ni-center-pill{width:56px;height:36px;background:var(--lime);border-radius:20px;display:flex;align-items:center;justify-content:center;margin-top:-8px;transition:all 0.15s;box-shadow:0 4px 16px rgba(200,255,0,0.4)}
.ni-center-pill:active{transform:scale(0.92)}
.ni-center-pill svg{width:18px;height:18px;stroke:#000;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.ni-center span{font-size:10px;color:var(--text4);font-weight:600;margin-top:2px;font-family:var(--font)}

/* ── TOPBAR ───────────────────────────────────────── */
.topbar{
  padding:calc(var(--safe-t) + 14px) 20px 14px;
  display:flex;align-items:center;justify-content:space-between;
  background:var(--white);
  border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:40;
  box-shadow:0 1px 8px rgba(0,0,0,0.06);
}
.m2logo img{height:24px;width:auto;display:block}
.topbar-right{display:flex;align-items:center;gap:10px}
.icon-btn{width:36px;height:36px;border-radius:50%;background:var(--white);display:flex;align-items:center;justify-content:center;cursor:pointer;border:1px solid var(--border);box-shadow:0 1px 4px rgba(0,0,0,0.06)}
.icon-btn svg{width:17px;height:17px;stroke:var(--text2);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.av-circle{width:34px;height:34px;border-radius:50%;background:var(--black);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;cursor:pointer;font-family:var(--font)}

/* ── LAYOUT HELPERS ───────────────────────────────── */
.px{padding-left:20px;padding-right:20px}
.px16{padding-left:16px;padding-right:16px}
.sec{padding:24px 20px 0}
.sec-sm{padding:16px 20px 0}
.divider{height:1px;background:var(--border);margin:0 20px}
.divider-full{height:10px;background:var(--bg);border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin:24px 0}

/* ── TYPE ─────────────────────────────────────────── */
.page-title{font-size:26px;font-weight:800;color:var(--text);letter-spacing:-0.5px;line-height:1.2}
.section-title{font-size:16px;font-weight:700;color:var(--text);letter-spacing:-0.2px}
.section-title-sm{font-size:13px;font-weight:700;color:var(--text);letter-spacing:0.2px;text-transform:uppercase}
.label{font-size:11px;font-weight:600;color:var(--text3);letter-spacing:0.4px;font-family:var(--font)}
.big-num{font-family:'Bebas Neue',sans-serif;letter-spacing:0px}

/* ── BUTTONS ──────────────────────────────────────── */
.btn-black{width:100%;padding:16px;background:var(--black);border:none;border-radius:var(--r2);font-family:var(--font);font-size:14px;font-weight:700;color:#fff;cursor:pointer;transition:all 0.15s;letter-spacing:0.3px}
.btn-black:active{opacity:0.85;transform:scale(0.98)}
.btn-outline{width:100%;padding:15px;background:transparent;border:1.5px solid var(--border);border-radius:var(--r2);font-family:var(--font);font-size:14px;font-weight:600;color:var(--text);cursor:pointer;transition:all 0.15s}
.btn-outline:active{background:var(--bg2)}
.chip{padding:7px 16px;border-radius:20px;font-family:var(--font);font-size:12px;font-weight:600;cursor:pointer;border:1.5px solid var(--border);background:transparent;color:var(--text2);transition:all 0.15s;white-space:nowrap}
.chip.active{background:var(--lime);color:#000;border-color:var(--lime);font-weight:800}
.chip:active{opacity:0.8}
.pill-btn{padding:8px 18px;border-radius:20px;font-family:var(--font);font-size:12px;font-weight:700;cursor:pointer;border:none;transition:all 0.15s;white-space:nowrap}
.pill-btn:active{transform:scale(0.95)}
.pill-black{background:var(--black);color:#fff}
.pill-light{background:var(--bg2);color:var(--text);border:1px solid var(--border)}
.pill-green{background:#DCFCE7;color:var(--green)}

/* ── CARDS ────────────────────────────────────────── */
.card{background:var(--bg);border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
.card2{background:var(--bg2);border-radius:var(--r2);overflow:hidden}
.card-row{display:flex;align-items:center;gap:12px;padding:16px;border-bottom:1px solid var(--border)}
.card-row:last-child{border-bottom:none}

/* ── HOME ─────────────────────────────────────────── */
.home-greeting{padding:calc(var(--safe-t) + 16px) 20px 20px;background:var(--white)}
.greeting-name{font-size:26px;font-weight:900;color:var(--text);letter-spacing:-0.8px;margin-bottom:4px}
.greeting-sub{font-size:14px;color:var(--text3);font-family:var(--font2);font-weight:400}
.greeting-sub span{color:var(--text2);font-weight:500}

/* STAT STRIP */
.stat-strip{display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--white);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;margin:0 20px 20px;box-shadow:var(--shadow)}
.stat-strip-item{padding:18px 12px;text-align:center;border-right:1px solid var(--border);background:var(--white)}
.stat-strip-item:last-child{border-right:none}
.stat-strip-num{font-size:30px;font-weight:900;color:var(--text);line-height:1;margin-bottom:3px;letter-spacing:-0.8px}
.stat-strip-lbl{font-size:10px;color:var(--text3);font-weight:600;letter-spacing:0.4px;font-family:var(--font)}

/* CHECK IN CARD */
.checkin-card{margin:0 20px 16px;border-radius:var(--r);background:var(--lime);padding:22px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;transition:all 0.12s;box-shadow:0 4px 20px rgba(200,255,0,0.35)}
.checkin-card:active{transform:scale(0.98)}
.checkin-lbl{font-size:10px;font-weight:700;color:rgba(0,0,0,0.45);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:5px;font-family:var(--font)}
.checkin-title{font-size:22px;font-weight:900;color:#000;letter-spacing:-0.5px;margin-bottom:3px}
.checkin-sub{font-size:12px;color:rgba(0,0,0,0.45);font-family:var(--font2)}
.checkin-arrow{width:44px;height:44px;border-radius:50%;background:rgba(0,0,0,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.checkin-arrow svg{width:18px;height:18px;stroke:#000;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}

/* NEXT RACE */
.race-strip{margin:0 20px 20px;background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:18px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;box-shadow:var(--shadow)}
.race-strip:active{background:var(--bg2)}
.race-lbl{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:0.5px;text-transform:uppercase;margin-bottom:4px;font-family:var(--font)}
.race-name{font-size:16px;font-weight:700;color:var(--text);letter-spacing:-0.2px;margin-bottom:2px}
.race-date{font-size:12px;color:var(--text3);font-family:var(--font2)}
.race-days-box{text-align:right}
.race-days-num{font-family:'Bebas Neue',sans-serif;font-size:52px;color:var(--black);line-height:1}
.race-days-lbl{font-size:10px;color:var(--text3);font-weight:600;letter-spacing:0.4px;font-family:var(--font)}

/* QUICK ACTIONS */
.qa-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 20px 20px}
.qa-card{border:1px solid var(--border);border-radius:var(--r);padding:20px;cursor:pointer;transition:all 0.15s;background:var(--white);box-shadow:var(--shadow)}
.qa-card:active{background:var(--bg2)}
.qa-icon-wrap{width:42px;height:42px;border-radius:var(--r2);background:var(--lime);display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.qa-icon-wrap svg{width:18px;height:18px;stroke:#000;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.qa-title{font-size:15px;font-weight:800;color:var(--text);margin-bottom:3px;letter-spacing:-0.3px}
.qa-sub{font-size:12px;color:var(--text3);font-family:var(--font2)}

/* HEALTH ROWS */
.health-section-title{font-size:15px;font-weight:700;color:var(--text);padding:0 20px;margin-bottom:12px}
.health-card{margin:0 20px 16px;border:1px solid var(--border);border-radius:var(--r);overflow:hidden;background:var(--white);box-shadow:var(--shadow)}
.health-row{display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border);gap:12px}
.health-row:last-child{border-bottom:none}
.health-icon-wrap{width:36px;height:36px;border-radius:var(--r2);background:var(--bg2);display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid var(--border)}
.health-icon-wrap svg{width:16px;height:16px;stroke:var(--text2);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.health-label{font-size:13px;font-weight:600;color:var(--text);flex:1;font-family:var(--font)}
.health-val{font-size:13px;font-weight:700;color:var(--text);text-align:right}
.health-sub-val{font-size:11px;color:var(--text3);text-align:right;margin-top:1px;font-family:var(--font2)}

/* ── CLASSES ──────────────────────────────────────── */
.cls-header{padding:calc(var(--safe-t) + 14px) 20px 0;background:var(--white);position:sticky;top:0;z-index:40;border-bottom:1px solid var(--border);box-shadow:0 2px 8px rgba(0,0,0,0.06)}
.cls-month-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.cls-month-title{font-size:22px;font-weight:800;color:var(--text);letter-spacing:-0.4px}
.loc-chip{display:flex;align-items:center;gap:5px;background:var(--bg2);border:1px solid var(--border);border-radius:20px;padding:6px 12px}
.loc-chip svg{width:12px;height:12px;stroke:var(--text3);fill:none;stroke-width:2}
.loc-chip span{font-size:11px;font-weight:600;color:var(--text2);font-family:var(--font)}

/* DAY PILLS */
.day-scroll{display:flex;gap:8px;overflow-x:auto;padding-bottom:14px;scrollbar-width:none}
.day-scroll::-webkit-scrollbar{display:none}
.day-pill{flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:2px;padding:9px 12px;border-radius:var(--r2);cursor:pointer;transition:all 0.15s;min-width:48px;border:1.5px solid transparent}
.day-pill .dn{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:0.5px}
.day-pill .dd{font-size:22px;font-weight:800;color:var(--text2);line-height:1;letter-spacing:-0.5px}
.day-pill.active{background:var(--black);border-color:var(--black)}
.day-pill.active .dn{color:rgba(255,255,255,0.5)}
.day-pill.active .dd{color:#fff}
.day-pill .dot{width:4px;height:4px;border-radius:50%;background:var(--text4);margin-top:2px}
.day-pill.active .dot{background:rgba(255,255,255,0.3)}

/* TOD BAR */
.tod-row{display:flex;gap:6px;overflow-x:auto;padding-bottom:14px;scrollbar-width:none}
.tod-row::-webkit-scrollbar{display:none}

/* CLASS CARD */
.cls-item{display:flex;align-items:center;padding:16px 20px;border-bottom:1px solid var(--border);gap:0;background:var(--white)}
.cls-item:last-child{border-bottom:none}
.cls-time-col{width:62px;flex-shrink:0}
.cls-time-hr{font-size:17px;font-weight:800;color:var(--text);line-height:1;letter-spacing:-0.3px}
.cls-time-ap{font-size:11px;color:var(--text3);font-weight:500;margin-top:1px;font-family:var(--font2)}
.cls-sep{width:1px;height:44px;background:var(--border);flex-shrink:0;margin:0 14px}
.cls-body{flex:1;min-width:0}
.cls-name{font-size:15px;font-weight:700;color:var(--text);letter-spacing:-0.2px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cls-meta{font-size:12px;color:var(--text3);font-family:var(--font2);margin-bottom:6px}
.cls-tags{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.cls-tag{font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;letter-spacing:0.3px;font-family:var(--font)}
.tag-hyrox{background:#FFF7ED;color:#EA580C}
.tag-strength{background:#F0F0F0;color:#555}
.tag-hiit{background:#FEF2F2;color:var(--red)}
.tag-yoga{background:#EFF6FF;color:var(--blue)}
.tag-pump{background:#F0FDF4;color:var(--green)}
.cls-spots{font-size:11px;color:var(--text3);font-family:var(--font2)}
.cls-note{font-size:11px;color:var(--text3);font-family:var(--font2);font-style:italic;margin-top:3px}
.cls-btn-col{flex-shrink:0;padding-left:12px}
.book-btn{padding:9px 16px;border-radius:20px;border:none;font-family:var(--font);font-size:12px;font-weight:700;cursor:pointer;transition:all 0.15s;white-space:nowrap}
.book-btn:active{transform:scale(0.95)}
.b-free{background:var(--lime);color:#000;font-weight:800}
.b-booked{background:#F0FDF4;color:var(--green);border:1px solid #BBF7D0}
.b-full{background:var(--bg2);color:var(--text4);border:1px solid var(--border);cursor:default}

/* ── COMMUNITY ────────────────────────────────────── */
.comm-tab-bar{display:flex;border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none;padding:0 20px;background:var(--white);position:sticky;top:0;z-index:30;box-shadow:0 2px 8px rgba(0,0,0,0.04)}
.comm-tab-bar::-webkit-scrollbar{display:none}
.comm-tab{flex-shrink:0;padding:14px 14px 13px;font-size:13px;font-weight:700;color:var(--text3);cursor:pointer;border-bottom:2px solid transparent;transition:all 0.15s;white-space:nowrap;font-family:var(--font)}
.comm-tab.active{color:var(--black);border-bottom-color:var(--lime)}

/* POST */
.post-item{padding:16px 20px;border-bottom:1px solid var(--border);background:var(--white)}
.post-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.post-av{width:38px;height:38px;border-radius:50%;object-fit:cover;object-position:top;border:1px solid var(--border);flex-shrink:0}
.post-av-init{width:38px;height:38px;border-radius:50%;background:var(--black);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex-shrink:0;border:1px solid var(--border)}
.post-name{font-size:14px;font-weight:700;color:var(--text)}
.post-meta{font-size:11px;color:var(--text3);font-family:var(--font2)}
.post-follow{margin-left:auto;padding:6px 14px;border-radius:20px;border:1.5px solid var(--border);background:transparent;font-family:var(--font);font-size:12px;font-weight:700;color:var(--text);cursor:pointer;transition:all 0.15s}
.post-follow.following{background:#F0FDF4;color:var(--green);border-color:#BBF7D0}
.post-follow:active{transform:scale(0.95)}
.workout-box{background:var(--bg);border:1px solid var(--border);border-radius:var(--r2);overflow:hidden;margin-bottom:10px}
.workout-box-head{padding:12px 14px;border-bottom:1px solid var(--border)}
.workout-box-name{font-size:14px;font-weight:700;color:var(--text);margin-bottom:6px}
.workout-box-stats{display:flex;gap:14px}
.wbs{font-size:11px;color:var(--text3);font-family:var(--font2)}
.wbs span{color:var(--text2);font-weight:600}
.workout-box-ex{padding:8px 14px}
.wbex-row{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border2);font-size:12px;font-family:var(--font2)}
.wbex-row:last-child{border-bottom:none}
.wbex-name{color:var(--text2)}
.wbex-val{color:var(--black);font-weight:800}
.post-caption{font-size:14px;color:var(--text2);line-height:1.6;margin-bottom:8px;font-family:var(--font2)}
.post-likes{font-size:13px;font-weight:600;color:var(--text3);margin-bottom:10px;font-family:var(--font)}
.post-likes strong{color:var(--text)}
.post-actions{display:flex;gap:4px}
.post-action{display:flex;align-items:center;gap:5px;padding:7px 10px;border:none;background:transparent;font-size:12px;color:var(--text3);cursor:pointer;font-family:var(--font);font-weight:600;border-radius:var(--r3);transition:all 0.15s}
.post-action:active{background:var(--bg2)}
.post-action svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.post-action.liked{color:var(--red)}
.post-action.liked svg{fill:var(--red);stroke:var(--red)}

/* LEADERBOARD */
.lb-row{display:flex;align-items:center;gap:12px;padding:14px 20px;border-bottom:1px solid var(--border);background:var(--white)}
.lb-row:last-child{border-bottom:none}
.lb-row.me-row{background:rgba(200,255,0,0.1);border-left:3px solid var(--lime)}
.lb-pos{font-size:14px;font-weight:800;width:26px;text-align:center;flex-shrink:0;color:var(--text3)}
.lb-pos.p1{color:#F59E0B}
.lb-pos.p2{color:#9CA3AF}
.lb-pos.p3{color:#B45309}
.lb-av{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;background:var(--bg3);color:var(--text);flex-shrink:0;border:1px solid var(--border)}
.lb-info{flex:1}
.lb-name{font-size:14px;font-weight:700;color:var(--text)}
.lb-sub{font-size:11px;color:var(--text3);font-family:var(--font2)}
.lb-val{font-family:'Bebas Neue',sans-serif;font-size:24px;color:var(--black)}

/* CHALLENGES */
.ch-item{margin:0 20px 12px;border:1px solid var(--border);border-radius:var(--r);padding:18px;background:var(--white);box-shadow:var(--shadow)}
.ch-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.ch-name{font-size:15px;font-weight:700;color:var(--text);letter-spacing:-0.2px}
.ch-prize{font-size:11px;font-weight:700;color:var(--black);background:var(--bg2);border:1px solid var(--border);border-radius:20px;padding:3px 10px;font-family:var(--font)}
.ch-desc{font-size:13px;color:var(--text2);margin-bottom:12px;line-height:1.5;font-family:var(--font2)}
.ch-progress{height:3px;background:var(--bg3);border-radius:2px;margin-bottom:8px;overflow:hidden}
.ch-bar{height:100%;background:var(--lime);border-radius:2px;transition:width 0.5s}
.ch-stats{display:flex;justify-content:space-between;font-size:11px;color:var(--text3);font-family:var(--font)}
.ch-you{font-weight:700;color:var(--lime-dark)}

/* WOTW */
.wotw-header-bar{background:var(--lime);padding:12px 20px;display:flex;align-items:center;justify-content:space-between}
.wotw-header-bar .lbl{font-size:11px;font-weight:800;color:rgba(0,0,0,0.55);letter-spacing:1px;text-transform:uppercase;font-family:var(--font)}
.wotw-header-bar .ends{font-size:11px;color:rgba(0,0,0,0.4);font-family:var(--font2)}
.wotw-body{padding:20px}
.wotw-name{font-size:22px;font-weight:800;color:var(--text);letter-spacing:-0.5px;margin-bottom:8px}
.wotw-desc{font-size:14px;color:var(--text2);line-height:1.6;margin-bottom:16px;font-family:var(--font2)}
.wotw-move{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);font-size:14px}
.wotw-move:last-child{border-bottom:none}
.wotw-move-name{color:var(--text2);font-family:var(--font2)}
.wotw-move-val{font-weight:700;color:var(--text);font-family:var(--font)}
.coach-tip{background:rgba(200,255,0,0.1);border-left:3px solid var(--lime);border-radius:0 var(--r2) var(--r2) 0;padding:12px 14px;font-size:13px;color:var(--text2);margin:16px 0;line-height:1.6;font-family:var(--font2)}
.coach-tip strong{color:var(--text);font-family:var(--font)}

/* ── RECOVERY ─────────────────────────────────────── */
.trainer-scroll{display:flex;gap:10px;overflow-x:auto;padding:0 20px 16px;scrollbar-width:none}
.trainer-scroll::-webkit-scrollbar{display:none}
.trainer-card{flex-shrink:0;width:108px;cursor:pointer}
.trainer-card:active{opacity:0.85}
.trainer-img{width:108px;height:136px;border-radius:var(--r);overflow:hidden;border:1px solid var(--border);position:relative;margin-bottom:8px;box-shadow:var(--shadow)}
.trainer-img img{width:100%;height:100%;object-fit:cover;object-position:center top}
.trainer-name{font-size:13px;font-weight:700;color:var(--text);margin-bottom:1px}
.trainer-role{font-size:11px;color:var(--text3);font-family:var(--font2)}

/* FACILITIES */
.fac-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 20px 20px}
.fac-item{border:1px solid var(--border);border-radius:var(--r);padding:18px;background:var(--white);box-shadow:var(--shadow)}
.fac-icon-wrap{width:40px;height:40px;border-radius:var(--r2);background:var(--lime);display:flex;align-items:center;justify-content:center;margin-bottom:14px}
.fac-icon-wrap svg{width:18px;height:18px;stroke:var(--black);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.fac-name{font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px}
.fac-info{font-size:12px;color:var(--text3);margin-bottom:6px;font-family:var(--font2)}
.fac-temp{font-size:13px;font-weight:700;color:var(--black)}

/* PROTOCOL STEPS */
.proto-item{display:flex;gap:14px;padding:16px 20px;border-bottom:1px solid var(--border);align-items:flex-start}
.proto-item:last-child{border-bottom:none}
.proto-num{width:30px;height:30px;border-radius:50%;background:var(--lime);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;color:#000;flex-shrink:0;font-family:var(--font)}
.proto-title{font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px}
.proto-sub{font-size:13px;color:var(--text3);font-family:var(--font2);line-height:1.5}

/* ── PROFILE / ME ─────────────────────────────────── */
.profile-top{padding:calc(var(--safe-t) + 20px) 20px 20px;border-bottom:1px solid var(--border);background:var(--white)}
.profile-av-row{display:flex;align-items:center;gap:14px;margin-bottom:16px}
.profile-av-lg{width:60px;height:60px;border-radius:50%;background:var(--lime);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;color:#000;flex-shrink:0;font-family:var(--font);box-shadow:0 4px 16px rgba(200,255,0,0.4)}
.profile-name-lg{font-size:22px;font-weight:800;color:var(--text);letter-spacing:-0.4px;margin-bottom:3px}
.profile-sub{font-size:13px;color:var(--text3);font-family:var(--font2)}
.mem-badge-light{display:inline-flex;align-items:center;gap:6px;background:var(--bg2);border:1px solid var(--border);border-radius:20px;padding:5px 12px;margin-top:8px}
.mem-badge-light .dot{width:6px;height:6px;border-radius:50%;background:#00C851}
.mem-badge-light span{font-size:11px;font-weight:700;color:var(--text2);font-family:var(--font)}

/* PROFILE TABS */
.ptab-bar{display:flex;background:var(--white);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:30}
.ptab{flex:1;padding:13px 8px;text-align:center;font-size:12px;font-weight:700;color:var(--text3);cursor:pointer;border-bottom:2px solid transparent;transition:all 0.15s;font-family:var(--font)}
.ptab.active{color:var(--black);border-bottom-color:var(--lime)}
.ptab-pane{display:none;padding:20px;background:var(--bg)}
.ptab-pane.active{display:block}

/* STAT GRID */
.sg{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.sg-item{border:1px solid var(--border);border-radius:var(--r);padding:18px;background:var(--white);box-shadow:var(--shadow)}
.sg-val{font-size:30px;font-weight:800;color:var(--text);letter-spacing:-0.5px;line-height:1;margin-bottom:4px}
.sg-lbl{font-size:11px;color:var(--text3);font-weight:600;letter-spacing:0.3px}
.sg-trend{font-size:11px;color:var(--green);font-weight:600;margin-top:3px;font-family:var(--font2)}

/* BAR CHART */
.bar-wrap{display:flex;align-items:flex-end;gap:5px;height:48px;margin-bottom:8px}
.bar{flex:1;border-radius:3px 3px 0 0;background:var(--bg3);transition:height 0.3s}
.bar.active{background:var(--black)}
.bar-labels{display:flex;gap:5px}
.bar-lbl{flex:1;text-align:center;font-size:10px;color:var(--text4);font-weight:600;font-family:var(--font)}
.bar-lbl.active{color:var(--black);font-weight:800}

/* BADGES */
.badge-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.badge-item{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer}
.badge-circle{width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:transform 0.15s;border:2px solid var(--border)}
.badge-circle:active{transform:scale(0.9)}
.badge-circle svg{width:22px;height:22px;stroke:var(--text2);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.badge-earned .badge-circle{background:var(--lime);border-color:var(--lime)}
.badge-earned .badge-circle svg{stroke:#000}
.badge-locked .badge-circle{background:var(--bg2)}
.badge-name{font-size:9px;color:var(--text3);text-align:center;line-height:1.3;font-weight:600;font-family:var(--font)}
.badge-earned .badge-name{color:var(--black);font-weight:700}

/* GOALS */
.goal-item{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border)}
.goal-item:last-child{border-bottom:none}
.goal-name{font-size:14px;font-weight:700;color:var(--text);margin-bottom:2px}
.goal-sub{font-size:12px;color:var(--text3);font-family:var(--font2)}
.goal-badge{font-size:11px;font-weight:700;color:#000;background:var(--lime);border:none;border-radius:20px;padding:4px 10px;white-space:nowrap;font-family:var(--font)}

/* PR */
.pr-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border)}
.pr-row:last-child{border-bottom:none}
.pr-name{font-size:14px;font-weight:700;color:var(--text)}
.pr-date{font-size:11px;color:var(--text3);font-family:var(--font2);margin-top:1px}
.pr-val{font-size:22px;font-weight:900;color:var(--black);letter-spacing:-0.5px}

/* MEMBERSHIP CARD */
.mem-card{border:1px solid var(--border);border-radius:var(--r);overflow:hidden;margin-bottom:16px;background:var(--white);box-shadow:var(--shadow)}
.mem-card-top{padding:20px;border-bottom:1px solid var(--border)}
.mem-plan-name{font-family:'Bebas Neue',sans-serif;font-size:32px;color:var(--text);letter-spacing:1px;margin-bottom:6px}
.mem-price{font-size:28px;font-weight:800;color:var(--text);letter-spacing:-0.5px}
.mem-price span{font-size:13px;color:var(--text3);font-weight:400;letter-spacing:0;font-family:var(--font2)}
.mem-since{font-size:12px;color:var(--text3);font-family:var(--font2);margin-top:4px}
.mem-active-badge{display:inline-flex;align-items:center;gap:5px;background:#F0FDF4;border:1px solid #BBF7D0;border-radius:20px;padding:4px 10px;margin-bottom:12px}
.mem-active-badge .dot{width:5px;height:5px;border-radius:50%;background:var(--green)}
.mem-active-badge span{font-size:11px;font-weight:700;color:var(--green);font-family:var(--font)}
.mem-benefits{padding:16px 20px}
.mem-benefit{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--text2);margin-bottom:10px;font-family:var(--font2)}
.mem-benefit:last-child{margin-bottom:0}
.mem-benefit-check{width:18px;height:18px;border-radius:50%;background:var(--lime);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mem-benefit-check svg{width:10px;height:10px;stroke:#000;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.mem-actions{border-top:1px solid var(--border);display:grid;grid-template-columns:1fr 1fr}
.mem-action{padding:14px;text-align:center;cursor:pointer;transition:background 0.15s;border-right:1px solid var(--border)}
.mem-action:last-child{border-right:none}
.mem-action:active{background:var(--bg2)}
.mem-action-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:1px;font-family:var(--font)}
.mem-action-sub{font-size:11px;color:var(--text3);font-family:var(--font2)}

/* CONNECTED APPS */
.conn-item{border:1px solid var(--border);border-radius:var(--r);overflow:hidden;margin-bottom:10px;background:var(--white);box-shadow:var(--shadow)}
.conn-head{display:flex;align-items:center;gap:12px;padding:16px}
.conn-logo{width:40px;height:40px;border-radius:var(--r2);display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid var(--border)}
.conn-strava-bg{background:#FC4C02}
.conn-whoop-bg{background:#0D0D0D}
.conn-name{font-size:14px;font-weight:700;color:var(--text)}
.conn-status{font-size:12px;color:var(--text3);font-family:var(--font2)}
.conn-btn{margin-left:auto;font-family:var(--font)}
.conn-data{border-top:1px solid var(--border);display:grid;grid-template-columns:repeat(3,1fr);padding:12px 16px;gap:8px}
.conn-dv{font-size:18px;font-weight:800;color:var(--text);line-height:1;margin-bottom:2px}
.conn-dl{font-size:10px;color:var(--text3);font-weight:600;letter-spacing:0.3px;font-family:var(--font)}

/* SETTINGS */
.settings-section{margin-bottom:20px}
.settings-sec-lbl{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:0.5px;padding:0 2px;margin-bottom:8px;font-family:var(--font)}
.settings-group-card{border:1px solid var(--border);border-radius:var(--r);overflow:hidden;background:var(--white);box-shadow:var(--shadow)}
.settings-item{display:flex;align-items:center;gap:12px;padding:15px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:background 0.15s;background:var(--white)}
.settings-item:last-child{border-bottom:none}
.settings-item:active{background:var(--bg2)}
.settings-item-icon{width:36px;height:36px;border-radius:var(--r2);background:var(--bg2);display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid var(--border)}
.settings-item-icon svg{width:16px;height:16px;stroke:var(--text2);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.settings-item-label{font-size:14px;font-weight:600;color:var(--text);flex:1}
.settings-item-sub{font-size:12px;color:var(--text3);font-family:var(--font2)}
.settings-item-right{display:flex;align-items:center;gap:6px}
.settings-arrow{color:var(--text4);font-size:16px}

/* WALLET BUTTONS */
.wallet-row{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
.wallet-btn{width:100%;height:46px;border-radius:var(--r2);font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:all 0.15s;border:none}
.wallet-btn:active{transform:scale(0.97)}
.wallet-apple{background:#000;color:#fff}
.wallet-google{background:var(--bg2);color:var(--text);border:1.5px solid var(--border)}
.wallet-added{background:#F0FDF4;color:var(--green);border:1px solid #BBF7D0}

/* WORKOUT TRACKER */
.wt-timer{font-family:'Bebas Neue',sans-serif;font-size:56px;color:var(--text);letter-spacing:1px;line-height:1;text-align:center;padding:20px;border-bottom:1px solid var(--border)}
.wt-ex-card{border:1px solid var(--border);border-radius:var(--r);overflow:hidden;margin-bottom:10px;background:var(--bg)}
.wt-ex-head{padding:14px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.wt-ex-name{font-size:15px;font-weight:700;color:var(--text)}
.wt-ex-muscle{font-size:12px;color:var(--text3);font-family:var(--font2);margin-top:1px}
.set-header{display:grid;grid-template-columns:28px 1fr 1fr 36px;gap:8px;font-size:10px;color:var(--text3);text-align:center;padding:8px 12px;font-weight:700;letter-spacing:0.3px;font-family:var(--font);border-bottom:1px solid var(--border2)}
.set-row{display:grid;grid-template-columns:28px 1fr 1fr 36px;gap:8px;align-items:center;padding:6px 12px}
.set-num{font-size:12px;color:var(--text3);text-align:center;font-weight:700}
.set-in{height:38px;background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r3);text-align:center;font-size:15px;font-weight:700;font-family:var(--font);color:var(--text);outline:none;transition:border-color 0.15s}
.set-in:focus{border-color:var(--black)}
.set-done{width:34px;height:34px;border-radius:var(--r3);background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.15s}
.set-done svg{width:14px;height:14px;stroke:var(--text4);fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.set-done.checked{background:var(--black);border-color:var(--black)}
.set-done.checked svg{stroke:#fff}

/* CALENDAR */
.cal-nav-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.cal-month-title{font-size:18px;font-weight:800;color:var(--text);letter-spacing:-0.3px}
.cal-nav-btns{display:flex;gap:6px}
.cal-nav-btn{width:30px;height:30px;border-radius:50%;background:var(--bg2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;color:var(--text2)}
.cal-dow{display:grid;grid-template-columns:repeat(7,1fr);margin-bottom:6px}
.cal-dow-cell{text-align:center;font-size:10px;font-weight:700;color:var(--text3);padding:4px 0;letter-spacing:0.3px;font-family:var(--font)}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:50%;position:relative;cursor:pointer;font-size:11px;font-weight:600;color:var(--text3);transition:all 0.15s;font-family:var(--font)}
.cal-day:active{transform:scale(0.9)}
.cal-day.today{border:1.5px solid var(--black);color:var(--black)}
.cal-day.other-month{opacity:0.25}
.cal-day.has-session{background:var(--lime);color:#000;font-weight:800}
.cal-day.pr-day{background:var(--black);color:#fff}
.cal-day.pr-day::after{content:'';position:absolute;top:2px;right:2px;width:5px;height:5px;border-radius:50%;background:var(--lime)}
.cal-legend{display:flex;gap:14px;margin-top:14px;flex-wrap:wrap}
.cal-leg-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text3);font-family:var(--font);font-weight:600}
.cal-leg-dot{width:10px;height:10px;border-radius:50%}

/* REFER */
.refer-card{background:var(--lime);border-radius:var(--r);padding:22px;margin-bottom:8px;box-shadow:0 4px 20px rgba(200,255,0,0.3)}
.refer-num{font-size:36px;font-weight:800;color:var(--text);letter-spacing:-0.8px;margin-bottom:6px}
.refer-code{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r3);padding:10px 14px;font-size:13px;color:var(--text2);font-family:monospace;margin-bottom:14px}

/* QR */
.qr-white{background:#fff;border:1px solid var(--border);border-radius:var(--r2);padding:18px;display:inline-block}

/* SEARCH BAR */
.search-row{display:flex;align-items:center;gap:10px;background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:0 14px;height:42px}
.search-row svg{width:15px;height:15px;stroke:var(--text3);fill:none;stroke-width:1.8;flex-shrink:0}
.search-row input{flex:1;background:transparent;border:none;font-size:14px;font-family:var(--font2);color:var(--text);outline:none}
.search-row input::placeholder{color:var(--text4)}

/* FOLLOW CARDS */
.follow-scroll{display:flex;gap:10px;overflow-x:auto;padding:0 20px 4px;scrollbar-width:none}
.follow-scroll::-webkit-scrollbar{display:none}
.follow-card{flex-shrink:0;width:100px;border:1px solid var(--border);border-radius:var(--r);padding:12px;text-align:center;background:var(--bg)}
.follow-img{width:46px;height:46px;border-radius:50%;object-fit:cover;object-position:top;margin:0 auto 6px;border:1px solid var(--border)}
.follow-init{width:46px;height:46px;border-radius:50%;background:var(--black);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;margin:0 auto 6px;border:1px solid var(--border);font-family:var(--font)}
.follow-name{font-size:11px;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:1px}
.follow-role{font-size:9px;color:var(--text3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:8px;font-family:var(--font2)}
.follow-btn{width:100%;padding:5px;background:var(--black);border:none;border-radius:20px;font-size:10px;font-weight:700;color:#fff;cursor:pointer;font-family:var(--font);transition:all 0.15s}
.follow-btn.following{background:#F0FDF4;color:var(--green);border:1px solid #BBF7D0}

/* MODALS */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.4);backdrop-filter:blur(4px);z-index:100;display:none;align-items:flex-end}
.overlay.open{display:flex}
.sheet{background:var(--bg);border-radius:20px 20px 0 0;width:100%;max-height:88vh;overflow-y:auto;padding-bottom:calc(var(--safe-b) + 8px)}
.sh-handle{width:36px;height:4px;background:var(--border);border-radius:2px;margin:12px auto 0}
.sh-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border)}
.sh-title{font-size:18px;font-weight:800;color:var(--text);letter-spacing:-0.3px}
.sh-sub{font-size:13px;color:var(--text3);font-family:var(--font2);margin-top:2px}
.sh-close{width:30px;height:30px;border-radius:50%;background:var(--bg2);display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--text3);cursor:pointer;border:1px solid var(--border)}
.sh-body{padding:20px}
.sh-lbl{font-size:11px;font-weight:700;color:var(--text3);margin-bottom:7px;letter-spacing:0.3px;font-family:var(--font)}
.sh-input{width:100%;height:46px;background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r2);padding:0 14px;font-size:14px;font-family:var(--font2);color:var(--text);outline:none;transition:border-color 0.2s}
.sh-input:focus{border-color:var(--black)}
.sh-select{width:100%;height:46px;background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r2);padding:0 14px;font-size:14px;font-family:var(--font2);color:var(--text);outline:none}
.sh-ta{width:100%;background:var(--bg2);border:1.5px solid var(--border);border-radius:var(--r2);padding:12px 14px;font-size:14px;font-family:var(--font2);color:var(--text);outline:none;resize:none;min-height:90px;line-height:1.6;transition:border-color 0.2s}
.sh-ta:focus{border-color:var(--black)}
.sh-cta{width:100%;padding:15px;background:var(--black);border:none;border-radius:var(--r2);font-family:var(--font);font-size:14px;font-weight:700;color:#fff;cursor:pointer;transition:all 0.15s;margin-top:4px}
.sh-cta:active{transform:scale(0.98)}
.sh-divider{height:1px;background:var(--border);margin:16px 0}
.sh-note{font-size:12px;color:var(--text3);text-align:center;margin-top:10px;line-height:1.5;font-family:var(--font2)}

/* TOAST */
#toast{position:fixed;bottom:calc(var(--nav-h) + var(--safe-b) + 12px);left:50%;transform:translateX(-50%) translateY(16px);background:var(--black);color:#fff;padding:11px 22px;border-radius:24px;font-size:13px;font-weight:700;opacity:0;transition:all 0.3s;pointer-events:none;z-index:200;white-space:nowrap;font-family:var(--font);box-shadow:0 4px 20px rgba(0,0,0,0.3)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* RACE OPTS */
.race-opt{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border);cursor:pointer}
.race-opt:last-child{border-bottom:none}
.race-opt:active{opacity:0.7}
.race-opt-name{font-size:14px;font-weight:700;color:var(--text)}
.race-opt-date{font-size:12px;color:var(--text3);font-family:var(--font2);margin-top:1px}
.race-opt-arrow{font-size:16px;color:var(--text4)}

/* VIS TOGGLE */
.vis-toggle{display:flex;gap:8px;margin-bottom:16px}
.vis-opt{flex:1;padding:12px;border:1.5px solid var(--border);border-radius:var(--r2);text-align:center;cursor:pointer;transition:all 0.15s;background:var(--bg)}
.vis-opt.active{border-color:var(--black);background:var(--black)}
.vis-opt-icon{font-size:18px;margin-bottom:4px}
.vis-opt-lbl{font-size:12px;font-weight:700;color:var(--text);font-family:var(--font)}
.vis-opt.active .vis-opt-lbl{color:#fff}
.vis-opt-sub{font-size:10px;color:var(--text3);font-family:var(--font2)}
.vis-opt.active .vis-opt-sub{color:rgba(255,255,255,0.5)}

</style>
</head>
